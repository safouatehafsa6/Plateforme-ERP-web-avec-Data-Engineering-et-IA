# Copiez ce fichier en ".env" et adaptez les valeurs si besoin.
# Ne jamais committer le fichier ".env" reel dans Git (ajoutez-le au .gitignore).

# --- Base de donnees ERP ---
ERP_DB_USER=erp_user
ERP_DB_PASSWORD=erp_password
ERP_DB_NAME=erp_db

# --- MinIO (data lake) ---
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=minio_password
