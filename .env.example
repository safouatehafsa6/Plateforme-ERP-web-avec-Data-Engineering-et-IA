# Copiez ce fichier en ".env" et adaptez les valeurs si besoin.
# Ne jamais committer le fichier ".env" reel dans Git (ajoutez-le au .gitignore).

# --- Base de donnees ERP ---
ERP_DB_USER=erp_user
ERP_DB_PASSWORD=erp_password
ERP_DB_NAME=erp_db

# --- MinIO (data lake) ---
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=minio_password

# Secret DEDIE au jeton du Dashboard (differente de JWT_SECRET). Genere : voir docs/PIPELINE_DATA_ENGINEERING.md
DASHBOARD_TOKEN_SECRET=

# Facultatif : génération RAG avec un endpoint compatible OpenAI.
# La recherche/embeddings restent locaux; laissez vide pour afficher les extraits sans LLM.
RAG_LLM_BASE_URL=
RAG_LLM_MODEL=
RAG_LLM_API_KEY=
