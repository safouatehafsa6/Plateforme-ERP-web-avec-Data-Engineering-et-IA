DB_HOST=postgres-erp
DB_PORT=5432
DB_USER=erp_user
DB_PASSWORD=erp_password
DB_CENTRAL_NAME=erp_db
JWT_SECRET=change_moi_en_production
ENV=dev

# Adresse publique du frontend, utilisee pour construire le lien de
# verification encode dans le QR code des factures PDF.
FRONTEND_URL=http://localhost:3000

# Optionnel : cle secrete reCAPTCHA reelle (google.com/recaptcha/admin).
# Si absente, la cle de TEST officielle de Google est utilisee.
RECAPTCHA_SECRET_KEY=
