DB_HOST=postgres-erp
DB_PORT=5432
DB_USER=erp_user
DB_PASSWORD=erp_password
DB_CENTRAL_NAME=erp_db
JWT_SECRET=change_moi_en_production
ENV=dev

# Adresse publique du frontend, utilisee pour construire le lien de
# verification encode dans le QR code des factures PDF.
FRONTEND_URL=http://localhost:3000

# Optionnel : cle secrete reCAPTCHA reelle (google.com/recaptcha/admin).
# Si absente, la cle de TEST officielle de Google est utilisee.
RECAPTCHA_SECRET_KEY=

# --- Generation RAG (LLM) ---
# La recherche/embeddings restent locaux. Fournisseur : ollama (defaut) | openai | none
LLM_PROVIDER=ollama
# Ollama sur la machine hote (defaut) : http://host.docker.internal:11434/v1
# Ollama dans un conteneur du compose : http://ollama:11434/v1
# Ollama sur un serveur distant : http://IP_SERVEUR:11434/v1
RAG_LLM_BASE_URL=
# Defaut ollama : qwen2.5:3b (tient dans 4 Go de VRAM). Alternative plus qualitative : qwen2.5:7b
RAG_LLM_MODEL=
# Uniquement pour openai (jamais committer la vraie cle)
RAG_LLM_API_KEY=
